# Copy this to .env.staging / .env.production (never to .env.development —
# development's credentials and URL are hardcoded in config/, since they only
# ever point at a local, throwaway database). Real files are gitignored.
#
# Which one gets loaded is decided by TEST_ENV (see config/load-env.ts):
#   TEST_ENV=staging    -> loads .env.staging, then .env
#   TEST_ENV=production -> loads .env.production, then .env
#   (unset / development) -> loads .env.development, then .env

# --- Base URL ----------------------------------------------------------
STAGING_BASE_URL=https://staging.course-platform.example.com
PRODUCTION_BASE_URL=https://course-platform.example.com

# --- Credential profiles (staging) --------------------------------------
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=

STAGING_STUDENT_EMAIL=
STAGING_STUDENT_PASSWORD=

STAGING_STUDENT_FRESH_EMAIL=
STAGING_STUDENT_FRESH_PASSWORD=

STAGING_INSTRUCTOR_EMAIL=
STAGING_INSTRUCTOR_PASSWORD=

STAGING_INSTRUCTOR_OTHER_EMAIL=
STAGING_INSTRUCTOR_OTHER_PASSWORD=

# --- Credential profiles (production) -----------------------------------
# Keep this to read-only / smoke-test accounts only. See README "Running
# against production" before adding anything that can enroll, pay, or submit.
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_ADMIN_PASSWORD=

PRODUCTION_STUDENT_EMAIL=
PRODUCTION_STUDENT_PASSWORD=

PRODUCTION_STUDENT_FRESH_EMAIL=
PRODUCTION_STUDENT_FRESH_PASSWORD=

PRODUCTION_INSTRUCTOR_EMAIL=
PRODUCTION_INSTRUCTOR_PASSWORD=

PRODUCTION_INSTRUCTOR_OTHER_EMAIL=
PRODUCTION_INSTRUCTOR_OTHER_PASSWORD=
