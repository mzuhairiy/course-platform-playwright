{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node", "@playwright/test"],
        "outDir": "./dist"
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
